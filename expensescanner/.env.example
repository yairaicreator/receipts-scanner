# Copy to .env and fill in. See SETUP.md.

# Reads the receipt photos. Get one at https://aistudio.google.com/apikey
# Never expose this to the browser — it is only used server-side.
GEMINI_API_KEY=

# Postgres connection string — required in production, or every deploy loses
# its data. Vercel Postgres / Neon / Supabase all provide one.
DATABASE_URL=

# --- optional ---

# Which model reads the receipts: "gemini" (default) or "claude".
# SCAN_PROVIDER=gemini

# Override the model. Defaults: gemini-3.7-flash / claude-opus-5.
# GEMINI_MODEL=
# ANTHROPIC_MODEL=

# Only needed if SCAN_PROVIDER=claude. https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
